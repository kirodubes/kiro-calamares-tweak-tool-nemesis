msgstr "Aucune configuration Calamares dans {path}"

#: usr/share/calamares-tweak-tool/main.py:124
#, python-brace-format
msgid "Permission denied: relaunch as root to edit {path}"
msgstr "Accès refusé : relancez en tant que root pour modifier {path}"

#: usr/share/calamares-tweak-tool/main.py:127
#, python-brace-format
msgid "Failed: {error}"
msgstr "Échec : {error}"

#: usr/share/calamares-tweak-tool/main.py:130
#, python-brace-format
