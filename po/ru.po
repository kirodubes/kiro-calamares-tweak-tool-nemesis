#, python-brace-format
msgid "System ({language})"
msgstr "Системный ({language})"

#: usr/share/calamares-tweak-tool/Tweaker.qml:99
msgid "dev · bootloader · encryption"
msgstr "dev · загрузчик · шифрование"

#: usr/share/calamares-tweak-tool/Tweaker.qml:121
msgid "Switch to light themes"
msgstr "Переключиться на светлые темы"

#: usr/share/calamares-tweak-tool/Tweaker.qml:121
msgid "Switch to dark themes"
msgstr "Переключиться на тёмные темы"

#: usr/share/calamares-tweak-tool/Tweaker.qml:156
msgid "Language"
msgstr "Язык"

#: usr/share/calamares-tweak-tool/Tweaker.qml:217
msgid ""
"Saved. Calamares Tweak Tool shows the new language when it starts again."
msgstr ""
"Сохранено. Calamares Tweak Tool покажет новый язык при следующем запуске."

#: usr/share/calamares-tweak-tool/Tweaker.qml:221
msgid "Restart now"
msgstr "Перезапустить"

#: usr/share/calamares-tweak-tool/Tweaker.qml:251
msgid "No Calamares config found at {path}"
msgstr "Конфигурация Calamares не найдена в {path}"

#. TRANSLATORS: card title, written in capitals
#: usr/share/calamares-tweak-tool/Tweaker.qml:267
msgid "BOOTLOADER"
msgstr "ЗАГРУЗЧИК"

#. TRANSLATORS: card title, written in capitals
#: usr/share/calamares-tweak-tool/Tweaker.qml:297
msgid "ENCRYPTION"
msgstr "ШИФРОВАНИЕ"

#. TRANSLATORS: "Encrypt system" is the checkbox in Calamares; use Calamares' own translation of it
#: usr/share/calamares-tweak-tool/Tweaker.qml:299
msgid "show the “Encrypt system” option in the installer"
msgstr "показывать параметр «Зашифровать систему» в установщике"

#: usr/share/calamares-tweak-tool/Tweaker.qml:329
msgid ""
"Both GRUB (2.14+) and systemd-boot unlock LUKS2/Argon2id at boot — the "
"stronger KDF."
msgstr ""
"И GRUB (2.14+), и systemd-boot разблокируют LUKS2/Argon2id при загрузке; это "
"более стойкая KDF."

#: usr/share/calamares-tweak-tool/Tweaker.qml:407
msgid ""
"Read-only: relaunch as root (e.g. sudo -E calamares-tweak-tool) to save "
"changes."
msgstr ""
"Только чтение: перезапустите от имени root (например, sudo -E calamares-"
"tweak-tool), чтобы сохранить изменения."

#: usr/share/calamares-tweak-tool/Tweaker.qml:429
msgid ""
"Encryption ON — don't forget to tick “Encrypt system”\n"
"and set a passphrase in the installer."
msgstr ""
"Шифрование ВКЛЮЧЕНО: не забудьте отметить «Зашифровать систему»\n"
"и задать парольную фразу в установщике."

#: usr/share/calamares-tweak-tool/Tweaker.qml:430
msgid ""
"Encryption is OFF — turn the switch on, or the installer won't offer to "
"encrypt."
msgstr ""
"Шифрование ВЫКЛЮЧЕНО: включите переключатель, иначе установщик не предложит "
"шифрование."

#: usr/share/calamares-tweak-tool/Tweaker.qml:439
msgid "Apply"
msgstr "Применить"

#: usr/share/calamares-tweak-tool/Tweaker.qml:453
msgid "Launch installer"
msgstr "Запустить установщик"

#: po/calamares-tweak-tool.desktop.in:3
msgid "Calamares Tweak Tool"
msgstr "Calamares Tweak Tool"

#: po/calamares-tweak-tool.desktop.in:4
msgid "Dev/expert: set Calamares encryption + bootloader before installing"
msgstr ""
"Для разработчиков и экспертов: настройка шифрования и загрузчика Calamares "
"перед установкой"

#: po/calamares-tweak-tool.desktop.in:9
msgid "calamares;installer;luks;encryption;bootloader;"
msgstr "calamares;installer;luks;encryption;bootloader;установщик;шифрование;загрузчик;"
